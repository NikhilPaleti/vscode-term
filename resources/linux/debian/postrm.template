rm -f /usr/bin/@@NAME@@

# Uninstall the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database for removed workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# NOTE: this package never installs an apt source list or signing key, so it must
# not remove one here. The upstream script removed `vscode.sources` and
# `/usr/share/keyrings/microsoft.gpg`, which would break a real VS Code install.
